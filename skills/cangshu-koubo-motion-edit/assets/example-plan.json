  "captions": [
    {
      "start": 0.0,
      "end": 1.03,
      "text": "互联网增量时代"
    },
    {
      "start": 1.03,
      "end": 3.11,
      "text": "各家公司把工资开得越来越高"
    },
    {
      "start": 3.11,
      "end": 4.61,
      "text": "恨不得把所谓的人才"
    },
    {
      "start": 4.61,
      "end": 5.95,
      "text": "全揣进自己兜里"
    },
    {
      "start": 5.95,
      "end": 9.07,
      "text": "但是现在进入存量内卷时代"
    },
    {
      "start": 9.07,
      "end": 11.05,
      "text": "再加上每个人都驾驶上了"
    },
    {
      "start": 11.05,
      "end": 12.03,
      "text": "AI 这台高达"
    },
    {
      "start": 12.03,
      "end": 13.99,
      "text": "大模型算法这些领域"
    },
    {
      "start": 13.99,
      "end": 15.71,
      "text": "可能确实还需要顶尖人才"
    },
    {
      "start": 15.71,
      "end": 16.79,
      "text": "但你别忘了"
    },
    {
      "start": 16.79,
      "end": 19.05,
      "text": "互联网95%的业务需求"
    },
    {
      "start": 19.05,
      "end": 21.01,
      "text": "说白了那就是增删改查"
    },
    {
      "start": 21.01,
      "end": 22.95,
      "text": "加个按钮改个逻辑的事"
    },
    {
      "start": 22.95,
      "end": 24.95,
      "text": "需求本身就这么浅"
    },
    {
      "start": 24.95,
      "end": 27.79,
      "text": "只要驾驶上顶尖的大模型"
    },
    {
      "start": 27.79,
      "end": 29.17,
      "text": "你让一个北大毕业的"
    },
    {
      "start": 29.17,
      "end": 29.95,
      "text": "来写这个代码"
    },
    {
      "start": 29.95,
      "end": 31.09,
      "text": "和一个中专毕业"
    },
    {
      "start": 31.09,
      "end": 33.15,
      "text": "学了半年Java的程序员来写"
    },
    {
      "start": 33.15,
      "end": 35.59,
      "text": "最后的结果它真能差多少吗"
    },
    {
      "start": 35.59,
      "end": 38.69,
      "text": "很多时候你的能力"
    },
    {
      "start": 38.69,
      "end": 39.73,
      "text": "很多场景下"
    },
    {
      "start": 39.73,
      "end": 41.19,
      "text": "并不能带来更硬的结果"
    },
    {
      "start": 41.19,
      "end": 42.33,
      "text": "但是你的溢价"
    },
    {
      "start": 42.33,
      "end": 44.17,
      "text": "那公司可是实打实地付出去了"
    },
    {
      "start": 44.17,
      "end": 45.53,
      "text": "这个话不好听"
    },
    {
      "start": 45.53,
      "end": 46.69,
      "text": "但账就是这么算的"
    },
    {
      "start": 46.69,
      "end": 48.77,
      "text": "所以降本增效来的时候"
    },
    {
      "start": 48.77,
      "end": 49.91,
      "text": "先动谁"
    },
    {
      "start": 49.91,
      "end": 51.39,
      "text": "这个其实也不难猜了"
    }
  ],
